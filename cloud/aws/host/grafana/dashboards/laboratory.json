{
  "uid": "tinyevents-lab",
  "title": "TinyEvents laboratory",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "utc",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "dogfood"
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Interpretation",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Live infrastructure only. Runtime GC counters and per-kind latency are retained in each run's CSV/JSON reports. Gaps in minimal monitoring are deliberate, not zero. Match UTC variant windows; do not infer a leak or worker limit from one graph. Raw Prometheus storage is not exported by evidence checkpoints."
      }
    },
    {
      "id": 2,
      "title": "Host busy CPU (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tinyevents-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"host\",mode=\"idle\"}[2m])))",
          "legendFormat": "{{groupname}}{{name}}{{datname}}{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Host available memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tinyevents-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes{job=\"host\"}",
          "legendFormat": "{{groupname}}{{name}}{{datname}}{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Host swap used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tinyevents-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_SwapTotal_bytes{job=\"host\"} - node_memory_SwapFree_bytes{job=\"host\"}",
          "legendFormat": "{{groupname}}{{name}}{{datname}}{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Evidence/root filesystem available",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tinyevents-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{job=\"host\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}",
          "legendFormat": "{{groupname}}{{name}}{{datname}}{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Process resident memory by PID",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "tinyevents-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "namedprocess_namegroup_memory_bytes{job=\"processes\",memtype=\"resident\",groupname=~\"tinyevents-.*\"}",
          "legendFormat": "{{groupname}}{{name}}{{datname}}{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
