#cloud-config
package_update: true
packages:
  - ca-certificates
  - curl
  - git
  - jq
  - unzip

write_files:
  - path: /etc/tinyevents-lab/environment
    permissions: "0600"
    owner: root:root
    content: |
      LAB_EXPIRES_AT=${expires_at}
      LAB_RESULTS_BUCKET=${results_bucket}
  - path: /usr/local/sbin/tinyevents-lab-expiry
    permissions: "0755"
    owner: root:root
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      source /etc/tinyevents-lab/environment
      now_epoch="$(date -u +%s)"
      expiry_epoch="$(date -u -d "$LAB_EXPIRES_AT" +%s)"
      if [ "$now_epoch" -ge "$expiry_epoch" ]; then
        logger -t tinyevents-lab "Laboratory expiry reached; shutting down."
        /usr/sbin/shutdown -h now
      fi
  - path: /etc/systemd/system/tinyevents-lab-expiry.service
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=Enforce TinyEvents laboratory expiry
      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/tinyevents-lab-expiry
  - path: /etc/systemd/system/tinyevents-lab-expiry.timer
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=Check TinyEvents laboratory expiry every five minutes
      [Timer]
      OnBootSec=2min
      OnUnitActiveSec=5min
      Unit=tinyevents-lab-expiry.service
      [Install]
      WantedBy=timers.target

runcmd:
  - [mkdir, -p, /opt/tinyevents-lab/artifacts]
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, tinyevents-lab-expiry.timer]
  - [bash, -lc, "snap install amazon-ssm-agent --classic || true"]
  - [systemctl, enable, --now, snap.amazon-ssm-agent.amazon-ssm-agent.service]
  - [bash, -lc, "echo foundation-ready > /opt/tinyevents-lab/bootstrap-status"]

final_message: "TinyEvents AWS foundation bootstrap completed after $UPTIME seconds"

